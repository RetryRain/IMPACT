SYNTHESIS_DATABASE_URL=postgresql+psycopg://user:pass@placeholder-host/neondb?sslmode=require
DROPPED_ARTICLES_DATABASE_URL=postgresql+psycopg://user:pass@placeholder-host/neondb?sslmode=require

# Synthesis provider: deepseek (default) or openrouter
SYNTHESIS_PROVIDER=deepseek

# DeepSeek direct API (default provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (set SYNTHESIS_PROVIDER=openrouter to use)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

SYNTHESIS_BODY_CHAR_LIMIT=800
SYNTHESIS_TIMEOUT_SECONDS=120
SYNTHESIS_CONCURRENCY=3
SYNTHESIS_REPORT_PATH=logs/synthesis_reports.log

# Optional feedback DB (pruned when over size limit)
FEEDBACK_DATABASE_URL=

# Retention prune when any app DB exceeds this size (MiB)
DB_SIZE_LIMIT_MB=475
RETENTION_DAYS=10

# Clustering / event merge
ASSIGN_NEIGHBOR_K=5
EVENT_MERGE_THRESHOLD=0.74
EVENT_MERGE_SOFT_THRESHOLD=0.68
EVENT_MERGE_TITLE_JACCARD=0.35
